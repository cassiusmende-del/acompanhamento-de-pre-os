# Copie para .env e ajuste. O arquivo .env nunca é versionado.

# Banco (usado pelo docker compose)
POSTGRES_USER=precos
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=precos

# Conexão para rodar a aplicação fora do Docker (npm run dev) contra o banco do compose
DATABASE_URL=postgresql://precos:troque-esta-senha@localhost:5432/precos?schema=public

# Portas expostas apenas em 127.0.0.1
APP_PORT=3000
DB_PORT=5432

# Senha opcional para abrir a aplicação (HTTP Basic). Vazio = sem senha.
APP_PASSWORD=

# Retenção dos backups
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_MONTHLY=12
